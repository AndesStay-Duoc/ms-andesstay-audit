# Copiar a .env y completar. El archivo .env NO se versiona.

# --- Base de datos: esquema AUDIT ---
DB_URL=jdbc:oracle:thin:@//localhost:1521/FREEPDB1
DB_USER=audit
DB_PASSWORD=cambiar_esto

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=ms-andesstay-audit

# --- Identidad: tenant corporativo ---
JWT_ISSUER_STAFF=https://login.microsoftonline.com/<staff-tenant-id>/v2.0
JWT_AUDIENCE_STAFF=api://<staff-client-id>
